# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# STM32CubeIDE build artifacts (firmware/reflex/Debug/) —
# the makefile/objects.mk/sources.mk themselves are kept, they drive the
# command-line arm-none-eabi-gcc build; everything below is regenerated by it.
firmware/reflex/Debug/**/*.o
firmware/reflex/Debug/**/*.d
firmware/reflex/Debug/**/*.su
firmware/reflex/Debug/**/*.cyclo
firmware/reflex/Debug/*.elf
firmware/reflex/Debug/*.bin
firmware/reflex/Debug/*.hex
firmware/reflex/Debug/*.map
firmware/reflex/Debug/*.list
firmware/reflex/Debug/objects.list

# STM32CubeIDE workspace/IDE metadata (machine-specific)
firmware/reflex/.metadata/
*.launch
